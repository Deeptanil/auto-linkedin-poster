# ─── Core AI ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── LinkedIn App ──────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ─── LinkedIn Tokens (generated by scripts/setup_token.py) ────────────────────
LINKEDIN_ACCESS_TOKEN=your_access_token_here
LINKEDIN_REFRESH_TOKEN=your_refresh_token_here
LINKEDIN_TOKEN_EXPIRY=2026-09-15T00:00:00+00:00
LINKEDIN_REFRESH_TOKEN_EXPIRY=2027-07-15T00:00:00+00:00
LINKEDIN_MEMBER_URN=urn:li:person:YOUR_MEMBER_ID

# ─── Discord (for notifications) ──────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ─── Optional overrides ────────────────────────────────────────────────────────
# WARN_DAYS_BEFORE_EXPIRY=14
# REFRESH_DAYS_BEFORE_EXPIRY=10
# WARN_DAYS_BEFORE_REFRESH_EXPIRY=30
